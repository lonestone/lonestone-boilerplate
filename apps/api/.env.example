DATABASE_PORT=5111

# Email Configuration (MailDev)
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_SECURE=false
EMAIL_FROM=noreply@localhost.com

# Storage (RustFS locally; any S3-compatible provider in production)
STORAGE_BUCKET=lonestone
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=rustfsadmin
STORAGE_SECRET_ACCESS_KEY=rustfsadmin
STORAGE_FORCE_PATH_STYLE=true
STORAGE_CREATE_BUCKET=true
STORAGE_MAX_UPLOAD_SIZE=10485760

# AI Providers
