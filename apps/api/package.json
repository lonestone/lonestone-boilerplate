{
  "name": "@boilerstone/api",
  "version": "0.0.1",
  "private": true,
  "description": "",
  "license": "UNLICENSED",
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "vite build",
    "start": "dotenvx run -- node --enable-source-maps dist/main.js",
    "dev": "dotenvx run -- vite-node --watch src/main.ts",
    "db:migration:init": "dotenvx run -- npx mikro-orm migration:create --initial",
    "db:migrate:create": "dotenvx run -- npx mikro-orm migration:create",
    "db:migrate:up": "dotenvx run -- npx mikro-orm migration:up",
    "db:migrate:down": "dotenvx run -- npx mikro-orm migration:down",
    "db:migrate:fresh": "dotenvx run -- npx mikro-orm migration:fresh",
    "db:migrate:seed": "dotenvx run -- npx mikro-orm migration:fresh --seed",
    "db:fresh": "dotenvx run -- npx mikro-orm schema:fresh --run",
    "db:fresh:seed": "dotenvx run -- npx mikro-orm schema:fresh --run --seed",
    "db:sync": "dotenvx run -- npx mikro-orm schema:update --run",
    "db:entities": "dotenvx run -- npx mikro-orm discovery:export --path './src/**/entities/*.entity.ts' --path './src/modules/example/**/*.entity.ts' --out './src/modules/db/entities.generated.ts'",
    "auth:generate": "dotenvx run -- auth generate --config src/modules/auth/auth.cli.mts --yes",
    "test": "cross-env NODE_ENV=test vitest run --config=vite.config.ts",
    "test:watch": "cross-env NODE_ENV=test vitest --config=vite.config.ts --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.105",
    "@ai-sdk/google": "^3.0.103",
    "@ai-sdk/mcp": "^1.0.66",
    "@ai-sdk/mistral": "^3.0.53",
    "@ai-sdk/openai": "^3.0.90",
    "@amplication/opentelemetry-nestjs": "7.0.0",
    "@dotenvx/dotenvx": "^1.75.1",
    "@faker-js/faker": "^10.5.0",
    "@langfuse/client": "^4.6.1",
    "@langfuse/otel": "^4.6.1",
    "@langfuse/tracing": "^4.6.1",
    "@mikro-orm/cli": "7.1.4",
    "@mikro-orm/core": "7.1.4",
    "@mikro-orm/decorators": "7.1.4",
    "@mikro-orm/migrations": "7.1.4",
    "@mikro-orm/nestjs": "7.1.0",
    "@mikro-orm/postgresql": "7.1.4",
    "@mikro-orm/seeder": "7.1.4",
    "@nestjs/cli": "12.0.8",
    "@nestjs/common": "12.1.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@scalar/nestjs-api-reference": "^1.2.12",
    "@sentry/nestjs": "^10.69.0",
    "@sentry/opentelemetry": "^10.69.0",
    "@testcontainers/postgresql": "^11.14.0",
    "ai": "^6.0.241",
    "better-auth": "catalog:auth",
    "date-fns": "^4.4.0",
    "express": "^5.2.1",
    "nestjs-pino": "5.2.0",
    "nodemailer": "^8.0.11",
    "pg": "^8.22.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "pino-pretty": "13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "slugify": "^1.6.9",
    "zod": "catalog:validation",
    "zod-openapi": "catalog:validation"
  },
  "devDependencies": {
    "@better-fetch/fetch": "1.3.1",
    "@nestjs/schematics": "12.0.6",
    "@nestjs/testing": "12.1.2",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.15.47",
    "@types/express": "^5.0.6",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.3",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "auth": "1.6.25",
    "better-call": "1.3.7",
    "cross-env": "^10.1.0",
    "kysely": "0.28.16",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "test": "^3.3.0",
    "ts-node": "^10.9.2",
    "typescript": "catalog:build",
    "unplugin-swc": "^1.5.10",
    "vite": "catalog:build",
    "vite-node": "^5.3.0",
    "vitest": "^4.1.10"
  },
  "mikro-orm": {
    "preferTs": true,
    "configPaths": [
      "./src/modules/db/db.config.ts"
    ]
  }
}
