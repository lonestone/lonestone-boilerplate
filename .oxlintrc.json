{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "import", "unicorn", "node", "jsx-a11y", "promise"],
  "env": {
    "node": true,
    "browser": true
  },
  "settings": {
    "react": {
      "version": "19.2.8"
    }
  },
  "ignorePatterns": [
    "**/.react-router/**",
    "**/*.gen.ts",
    "**/dist/**",
    "**/temp/**",
    "**/build/**",
    "packages/openapi-generator/client/**",
    "**/.astro/**",
    "node_modules/**",
    "**/.worktrees/**",
    "CLAUDE.md",
    "AGENTS.md",
    "**/README.md",
    "pnpm-workspace.yaml"
  ],
  "rules": {
    "typescript/no-explicit-any": "error"
  },
  "overrides": [
    {
      "files": ["apps/api/**/*.ts", "apps/api/**/*.json"],
      "rules": {
        "typescript/consistent-type-imports": "off"
      }
    },
    {
      "files": ["apps/api/src/**/*.ts"],
      "rules": {
        "eslint/no-restricted-properties": [
          "error",
          {
            "property": "fork",
            "message": "Do not call em.fork() in the API. The request already has its own EntityManager. For two or more writes, decorate the method with @Transactional(). Outside a request, add a comment that says why, then // oxlint-disable-next-line. See references/backend.mdx, section Queries."
          },
          {
            "property": "transactional",
            "message": "Do not call em.transactional() by hand. Decorate the method with @Transactional() from @mikro-orm/decorators/legacy. See references/backend.mdx, section Queries."
          }
        ]
      }
    },
    {
      "files": ["apps/api/src/**/*spec.ts", "apps/api/src/test/**"],
      "rules": {
        "eslint/no-restricted-properties": "off"
      }
    },
    {
      "files": ["apps/api/**/*.entity.ts"],
      "rules": {
        "eslint/max-classes-per-file": ["error", 1]
      }
    }
  ]
}
