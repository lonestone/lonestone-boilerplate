{
  "name": "boilerstone",
  "version": "1.5.1",
  "private": true,
  "description": "Monorepo for Lonestone project",
  "keywords": [],
  "license": "MIT",
  "author": "",
  "type": "module",
  "scripts": {
    "prepare": "node -e \"require('fs').existsSync('.git')&&require('child_process').execSync('lefthook install',{stdio:'inherit'})\"",
    "rock": "boilerstone-cli rock",
    "boilerplate": "boilerstone-cli",
    "dev": "pnpm --parallel dev",
    "build": "vp run -r build",
    "check": "vp run -F './apps/web-*' typegen && vp check",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "fmt": "vp fmt",
    "generate": "pnpm --filter=@boilerstone/openapi-generator run generate",
    "test": "vp run -r test",
    "docs-only": "pnpm --filter=@boilerstone/documentation run dev",
    "knip": "knip --no-exit-code",
    "lint:pr": "vpx ./scripts/lint-pr.ts",
    "worktree:create": "vpx ./scripts/worktree.ts create",
    "worktree:remove": "vpx ./scripts/worktree.ts remove"
  },
  "dependencies": {
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/lint": "^21.2.2",
    "@commitlint/load": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@lonestone/boilerstone-cli": "workspace:*",
    "@types/node": "catalog:build",
    "knip": "^6.31.0",
    "lefthook": "^2.1.10",
    "tsx": "^4.23.5",
    "vite-plus": "catalog:build"
  },
  "engines": {
    "node": "24.22.2",
    "pnpm": "10.28.2"
  },
  "packageManager": "pnpm@10.28.2"
}
