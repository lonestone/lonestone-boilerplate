{
  "name": "boilerstone",
  "version": "1.1.0",
  "private": true,
  "description": "Monorepo for Lonestone project",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "scripts": {
    "rock": "lonestone rock",
    "boilerplate": "lonestone",
    "dev": "pnpm --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "generate": "pnpm --filter=@boilerstone/openapi-generator run generate",
    "test": "pnpm -r test",
    "docs-only": "pnpm --filter=@boilerstone/documentation run dev",
    "knip": "knip --no-exit-code",
    "lint:pr": "tsx ./scripts/lint-pr.ts"
  },
  "dependencies": {
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/lint": "^21.2.2",
    "@commitlint/load": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@lonestone/cli": "workspace:*",
    "@types/node": "catalog:build",
    "lefthook": "^2.1.10",
    "knip": "^6.31.0",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.77.0",
    "tsx": "^4.23.5"
  },
  "engines": {
    "node": "24.13.0",
    "pnpm": "10.28.2"
  },
  "packageManager": "pnpm@10.28.2"
}
