{
  "name": "@boilerstone/openapi-generator",
  "version": "0.0.1",
  "private": true,
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./client": "./client/index.ts",
    "./client/*": "./client/*.ts",
    "./client/core/*": "./client/core/*.ts"
  },
  "scripts": {
    "dev": "node ./preprocess/wait-for-docs.js && pnpm generate --watch",
    "preprocess": "node ./preprocess/index.js",
    "generate": "node ./preprocess/index.js && openapi-ts -f ./openapi-ts.config.ts"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.75.1",
    "@hey-api/openapi-ts": "^0.91.1",
    "cross-env": "^10.1.0",
    "node-fetch": "^3.3.2",
    "wait-on": "^9.1.0"
  },
  "peerDependencies": {
    "zod": "catalog:validation"
  }
}
