{
  "name": "@lonestone/boilerstone-cli",
  "version": "1.2.0",
  "description": "Lonestone boilerplate installer, project setup, and upgrade CLI",
  "keywords": [
    "boilerplate",
    "boilerstone",
    "lonestone"
  ],
  "license": "ISC",
  "author": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/lonestone/lonestone-boilerplate.git",
    "directory": ".boilerstone/cli"
  },
  "bin": {
    "boilerstone-cli": "./bin/boilerstone-cli.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "enquirer": "^2.4.1"
  },
  "devDependencies": {
    "@types/node": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.13.0"
  }
}
